# These values are safe for the extension bundle: public client keys are designed to be bundled.
# Never put a service-role key here — it would ship to every user.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The deployed UplyFox site the extension talks to.
# Leave these unset to use production; point them at localhost only for local development.
VITE_WEB_APP_URL=https://uply.foxea.xyz
VITE_AI_API_URL=https://uply.foxea.xyz/api/ai/answer
