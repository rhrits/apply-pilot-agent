# --- Web app (required) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only admin allowlist. Never prefix this with NEXT_PUBLIC_.
ADMIN_EMAIL=123admin@email.com

# Server-only email delivery for approved access codes.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@your-domain
RESEND_FROM_NAME=ApplyPilot

# --- AI (server-only, never prefix with NEXT_PUBLIC_) ---
# Providers are tried in order: Gemini first, then Mistral. Configure either or both.
# With both set, a throttled or failing provider automatically fails over to the other.

# Google Gemini — primary text provider (profile synthesis, resume structuring, answers).
# Free tier: roughly 15 requests/minute with a daily cap, which suits onboarding's
# small number of large calls. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Mistral — fallback text provider, and the default speech-to-text provider.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Speech to text (optional; defaults to Mistral Voxtral via MISTRAL_API_KEY) ---
# Point these at any OpenAI-compatible /audio/transcriptions endpoint to self-host
# faster-whisper or whisper.cpp instead of using a hosted provider.
# STT_BASE_URL=https://api.mistral.ai/v1
# STT_MODEL=voxtral-mini-latest
# STT_API_KEY=

# --- GitHub enrichment (optional) ---
# Without a token GitHub allows 60 requests/hour for public data.
# A classic token with NO scopes raises this to 5000/hour.
# GITHUB_TOKEN=
